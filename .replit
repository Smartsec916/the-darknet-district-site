entrypoint = "server.py"
modules = ["nodejs-20", "python-3.11", "web"]
run = "python server.py"

[nix]
channel = "stable-24_11"
packages = ["file", "freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "rename", "static-web-server", "tcl", "tk", "unixtools.xxd", "zlib"]

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "server:app"]

# Rewrite rules to remove .html extensions
[[deployment.rewrites]]
from = "/about"
to = "/about.html"

[[deployment.rewrites]]
from = "/games-list"
to = "/games-list.html"

[[deployment.rewrites]]
from = "/store-first-page"
to = "/store-first-page.html"

[[deployment.rewrites]]
from = "/store-apparel"
to = "/store-apparel.html"

[[deployment.rewrites]]
from = "/store-books"
to = "/store-books.html"

[[deployment.rewrites]]
from = "/store-electronics"
to = "/store-electronics.html"

[[deployment.rewrites]]
from = "/store-survival"
to = "/store-survival.html"

[[deployment.rewrites]]
from = "/store-apps"
to = "/store-apps.html"

[[deployment.rewrites]]
from = "/sleeping_pod"
to = "/sleeping_pod.html"

[[deployment.rewrites]]
from = "/chatbot"
to = "/chatbot.html"

[[deployment.rewrites]]
from = "/blackout-protocol"
to = "/blackout-protocol/index.html"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Frame-Options"
value = "SAMEORIGIN"

[[deployment.responseHeaders]]
path = "/*"
name = "X-Content-Type-Options"
value = "nosniff"

[[deployment.responseHeaders]]
path = "/*"
name = "Referrer-Policy"
value = "strict-origin-when-cross-origin"

[[deployment.responseHeaders]]
path = "/*"
name = "Permissions-Policy"
value = "geolocation=(), camera=(), microphone=()"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chat Server"

[[workflows.workflow]]
name = "Chat Server"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
