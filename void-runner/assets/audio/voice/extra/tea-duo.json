   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-001-greet-bf2138d2.mp3",
   "pool": "greet"
  },
  "nomi-greet-2": {
   "speaker": "nomi",
   "text": "[excited] Well, hello there, handsome! [giggles] We don't get many visitors this charming.",
   "file": "extra/tea-duo/nomi-greet-2.mp3",
   "duration": 5.55,
   "hash": "170203e65883b72dec74071f1757f918f60a54217c09afaaf443545453afa602",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-002-greet-1ab7cd33.mp3",
   "pool": "greet"
  },
  "nomi-greet-3": {
   "speaker": "nomi",
   "text": "[softly] Aww, don't be shy. Come a little closer.",
   "file": "extra/tea-duo/nomi-greet-3.mp3",
   "duration": 3.62,
   "hash": "946cb5b898934ee8180c5d7231960302de0ac2d7fcf98168ed85e6e87d21bcdf",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-003-greet-0fa0b1f8.mp3",
   "pool": "greet"
  },
  "nomi-greet-4": {
   "speaker": "nomi",
   "text": "[playfully] Were you looking for some tea... [whispers] or something a little sweeter?",
   "file": "extra/tea-duo/nomi-greet-4.mp3",
   "duration": 4.12,
   "hash": "5b6f0186be28619182af4f3bc818fd21562146ce4ffb0c3f136b4086126bad96",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-004-greet-c299dfad.mp3",
   "pool": "greet"
  },
  "nomi-greet-5": {
   "speaker": "nomi",
   "text": "[flirty] I think you're going to like it here. [giggles] We take very good care of our guests.",
   "file": "extra/tea-duo/nomi-greet-5.mp3",
   "duration": 5.06,
   "hash": "48917a1d192c1257bd3275ff7e17642d50fde3019ed038a264e5b907ae4c27d2",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-005-greet-dc11c3fa.mp3",
   "pool": "greet"
  },
  "nomi-approach-1": {
   "speaker": "nomi",
   "text": "[excited] Oh! A visitor! How lovely!",
   "file": "extra/tea-duo/nomi-approach-1.mp3",
   "duration": 3.31,
   "hash": "cbb7bfb64a3d6eeeecad6d33493f4b2814cc4915b8ff8e574ca2dba2d52ce489",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-066-approach-6841f3fe.mp3",
   "pool": "approach"
  },
  "nomi-approach-2": {
   "speaker": "nomi",
   "text": "[giggles] Hello, handsome! Mind if I come say hi?",
   "file": "extra/tea-duo/nomi-approach-2.mp3",
   "duration": 4.04,
   "hash": "eda1c49e409cb14c0a60e841be250eca40fbf74723d488cc69fbb74baf923a8f",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-067-approach-a6e8205f.mp3",
   "pool": "approach"
  },
  "nomi-approach-3": {
   "speaker": "nomi",
   "text": "[playfully] Well, look what the city brought us!",
   "file": "extra/tea-duo/nomi-approach-3.mp3",
   "duration": 2.68,
   "hash": "7855a0782c63d590e23260db7a24f7202620520f6d5f43384254b20bdcd333d8",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-068-approach-221575e1.mp3",
   "pool": "approach"
  },
  "nomi-approach-4": {
   "speaker": "nomi",
   "text": "[sweetly] Aww, you came all this way to see us?",
   "file": "extra/tea-duo/nomi-approach-4.mp3",
   "duration": 3.15,
   "hash": "67d153cd6483cd708c38b4578ce2e5939048be80f00833b619bd2c2dfede95ee",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-069-approach-407dafdc.mp3",
   "pool": "approach"
  },
  "nomi-approach-5": {
   "speaker": "nomi",
   "text": "[flirty] You look like someone in need of a little hospitality.",
   "file": "extra/tea-duo/nomi-approach-5.mp3",
   "duration": 3.54,
   "hash": "a9894922222d20c73971bb421229d741abe7ec517e8ea0642d46d89010091f7c",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-070-approach-1cfcddd0.mp3",
   "pool": "approach"
  },
  "nomi-welcomeBack-1": {
   "speaker": "nomi",
   "text": "[excited] Oh! Look who's back!",
   "file": "extra/tea-duo/nomi-welcomeBack-1.mp3",
   "duration": 2.5,
   "hash": "4eedfb3e588af4653446356a4d30ccdb619791193b20bad967dcf31eab83b376",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-106-welcomeback-3f56d1ed.mp3",
   "pool": "welcomeBack"
  },
  "nomi-welcomeBack-2": {
   "speaker": "nomi",
   "text": "[giggles] Couldn't stay away from our special tea, could you?",
   "file": "extra/tea-duo/nomi-welcomeBack-2.mp3",
   "duration": 3.85,
   "hash": "c4eee6487f51321ed87df85451bcc511365ff35dd21514f5079d38dce0a2fa62",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-107-welcomeback-779556ad.mp3",
   "pool": "welcomeBack"
  },
  "nomi-welcomeBack-3": {
   "speaker": "nomi",
   "text": "[sweetly] Aww, handsome! It's lovely seeing you again.",
   "file": "extra/tea-duo/nomi-welcomeBack-3.mp3",
   "duration": 4.04,
   "hash": "def20f40e0b22bf5a37b04b660606e12e10140c03a0043bfe05d7cf114cb7152",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-108-welcomeback-c379f134.mp3",
   "pool": "welcomeBack"
  },
  "nomi-welcomeBack-4": {
   "speaker": "nomi",
   "text": "[playfully] Back for another cup? I thought you might be.",
   "file": "extra/tea-duo/nomi-welcomeBack-4.mp3",
   "duration": 3.31,
   "hash": "a21f878dca20bb1aaabc2c923fc92391e2166c77ea9c309d018d540e8aa5a257",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-109-welcomeback-ad0d725b.mp3",
   "pool": "welcomeBack"
  },
  "nomi-welcomeBack-5": {
   "speaker": "nomi",
   "text": "[flirty] Well, well... someone's developed a taste for our hospitality.",
   "file": "extra/tea-duo/nomi-welcomeBack-5.mp3",
   "duration": 4.35,
   "hash": "26c69acc350a9f1bd1f28f742ca5781a81996a84d73393027625eaab97f1967c",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-110-welcomeback-593eef79.mp3",
   "pool": "welcomeBack"
  },
  "nomi-chat-1": {
   "speaker": "nomi",
   "text": "[sweetly] Would you like some tea, sweetheart? We have a very special blend.",
   "file": "extra/tea-duo/nomi-chat-1.mp3",
   "duration": 4.04,
   "hash": "8bab3c2f7cfa0e4116fd20d967319d0c150e7b3e12bb32159f4b68976f1dcdc5",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-006-chat-ec5be018.mp3",
   "pool": "chat"
  },
  "nomi-chat-2": {
   "speaker": "nomi",
   "text": "[giggles] Oh, we don't serve ordinary tea back here, silly!",
   "file": "extra/tea-duo/nomi-chat-2.mp3",
   "duration": 4.59,
   "hash": "4de7e2b76d4ab270bdf970ea8ca411b0a08a9e8bc05bbe5b5ece4f5d0a299efe",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-007-chat-7fbbb963.mp3",
   "pool": "chat"
  },
  "nomi-chat-3": {
   "speaker": "nomi",
   "text": "[playfully] Some customers come for the tea. Others come for the company.",
   "file": "extra/tea-duo/nomi-chat-3.mp3",
   "duration": 4.12,
   "hash": "9a09eec88ffd09fa4bf52dae2a00f1c6d14112ea14bcde39a2edec0b49865238",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-008-chat-0579414f.mp3",
   "pool": "chat"
  },
  "nomi-chat-4": {
   "speaker": "nomi",
   "text": "[warmly] It's always nicer when someone visits. Especially someone cute.",
   "file": "extra/tea-duo/nomi-chat-4.mp3",
   "duration": 4.59,
   "hash": "479de431da964e20b935442699822142c1841c1fedefeee403c7ddefaf8557e3",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-009-chat-f0e30d4f.mp3",
   "pool": "chat"
  },
  "nomi-chat-5": {
   "speaker": "nomi",
   "text": "[teasing] Our tea is quite famous. Although nobody ever asks what's in it.",
   "file": "extra/tea-duo/nomi-chat-5.mp3",
   "duration": 4.59,
   "hash": "48b341c1bb3e2bca6ede3f36eab8630f4584ea37db79251589096171900e1ed9",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-010-chat-e8157309.mp3",
   "pool": "chat"
  },
  "nomi-compliment-1": {
   "speaker": "nomi",
   "text": "[flirty] You have such lovely eyes. Has anyone told you that?",
   "file": "extra/tea-duo/nomi-compliment-1.mp3",
   "duration": 3.85,
   "hash": "172c0315198badc73ca500498f1c79b455fb36bd4d1b6910ee7526eb602fdffd",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-011-compliment-7d33624d.mp3",
   "pool": "compliment"
  },
  "nomi-compliment-2": {
   "speaker": "nomi",
   "text": "[giggles] You really are quite cute when you're nervous.",
   "file": "extra/tea-duo/nomi-compliment-2.mp3",
   "duration": 3.7,
   "hash": "beb1da2949382616b92758aea233d6c9bc39b47d76816b2d609f2b1eda100b3f",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-012-compliment-11a2a45c.mp3",
   "pool": "compliment"
  },
  "nomi-compliment-3": {
   "speaker": "nomi",
   "text": "[sweetly] I like your smile. You should show it more often.",
   "file": "extra/tea-duo/nomi-compliment-3.mp3",
   "duration": 3.23,
   "hash": "f4b815cc54c9511ee1e87a21f40de3bf93008de39529c2b99a4e755094e34113",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-013-compliment-d38634b1.mp3",
   "pool": "compliment"
  },
  "nomi-compliment-4": {
   "speaker": "nomi",
   "text": "[playfully] Oh, handsome, you're making it difficult for me to concentrate.",
   "file": "extra/tea-duo/nomi-compliment-4.mp3",
   "duration": 4.51,
   "hash": "634c38680545f59f153ab2d074eb46893b1b4d2239173aabbe178166f7a73506",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-014-compliment-44338c03.mp3",
   "pool": "compliment"
  },
  "nomi-compliment-5": {
   "speaker": "nomi",
   "text": "[softly] There's something about you I find rather irresistible.",
   "file": "extra/tea-duo/nomi-compliment-5.mp3",
   "duration": 4.12,
   "hash": "a281776dc6dc1d3c50e686e7533eeeed518ccf4b737e0f81619824a2766090be",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-015-compliment-d7e1c8ca.mp3",
   "pool": "compliment"
  },
  "nomi-flirt-1": {
   "speaker": "nomi",
   "text": "[teasing] Our special tea has a reputation for making people weak in the knees.",
   "file": "extra/tea-duo/nomi-flirt-1.mp3",
   "duration": 4.74,
   "hash": "53251c37668cf119d92c176aef5cf70d6b44e8374c77ca3ea3e2a4d46a45d21b",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-016-flirt-a05d21ab.mp3",
   "pool": "flirt"
  },
  "nomi-flirt-2": {
   "speaker": "nomi",
   "text": "[giggles] Careful, handsome. Some customers come back for seconds... and thirds.",
   "file": "extra/tea-duo/nomi-flirt-2.mp3",
   "duration": 6.6,
   "hash": "43a5999539b7047388f888756afae1f15f9d6542b13f2cfa42e99dfd5d9156b4",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-017-flirt-fc1e1f9a.mp3",
   "pool": "flirt"
  },
  "nomi-flirt-3": {
   "speaker": "nomi",
   "text": "[playfully] I promise our tea is worth every credit.",
   "file": "extra/tea-duo/nomi-flirt-3.mp3",
   "duration": 3.78,
   "hash": "284f28fa850aa4bce6445a3e8c0462d7f4955bd6b1ed66aae0a236fe59debc3e",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-018-flirt-c0fc0248.mp3",
   "pool": "flirt"
  },
  "nomi-flirt-4": {
   "speaker": "nomi",
   "text": "[whispers] I could tell you our secret recipe... but where's the fun in that?",
   "file": "extra/tea-duo/nomi-flirt-4.mp3",
   "duration": 4.43,
   "hash": "f927492fbaa241696e157d0f0184bfa9f0607c674fe6f82922cb936527592df9",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-019-flirt-6fdc8d1e.mp3",
   "pool": "flirt"
  },
  "nomi-flirt-5": {
   "speaker": "nomi",
   "text": "[flirty] We know how to make a gentleman feel very welcome.",
   "file": "extra/tea-duo/nomi-flirt-5.mp3",
   "duration": 3.96,
   "hash": "4291a2cda140e9da0406a9287e69382c109147eb9783e2134cd6c13fa9045e2a",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-020-flirt-4be8b888.mp3",
   "pool": "flirt"
  },
  "nomi-relax-1": {
   "speaker": "nomi",
   "text": "[softly] Just relax, sweetheart. There's no rush.",
   "file": "extra/tea-duo/nomi-relax-1.mp3",
   "duration": 3.07,
   "hash": "ab78bdbbcf502d588469e891a98e443a389ef2cc1f148d202285a085edf9d186",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-056-relax-e8cde6aa.mp3",
   "pool": "relax"
  },
  "nomi-relax-2": {
   "speaker": "nomi",
   "text": "[warmly] It's nice having someone here with us.",
   "file": "extra/tea-duo/nomi-relax-2.mp3",
   "duration": 2.26,
   "hash": "c157e7ff914340e3b8c151f4d29d2c357d008682b7902d11672d71217f870167",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-057-relax-9e351b17.mp3",
   "pool": "relax"
  },
  "nomi-relax-3": {
   "speaker": "nomi",
   "text": "[playfully] Another cup of our special tea, perhaps?",
   "file": "extra/tea-duo/nomi-relax-3.mp3",
   "duration": 3.15,
   "hash": "45b799297434c707616bce11f64dbcc15b5956afc6c66ebab879e31e22f4638f",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-058-relax-f97795b5.mp3",
   "pool": "relax"
  },
  "nomi-relax-4": {
   "speaker": "nomi",
   "text": "[whispers] Sometimes the best moments are the quiet ones.",
   "file": "extra/tea-duo/nomi-relax-4.mp3",
   "duration": 3.85,
   "hash": "7e3c295353551f2ba6c698242dfdf9c590726cdc93cc826305a2dda8f9494a7b",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-059-relax-82fcfabf.mp3",
   "pool": "relax"
  },
  "nomi-relax-5": {
   "speaker": "nomi",
   "text": "[sweetly] You look much more comfortable now.",
   "file": "extra/tea-duo/nomi-relax-5.mp3",
   "duration": 2.42,
   "hash": "1f8ee892930ac86e108be0aa455e39507375cf74b8aab59f68955f830bc9455a",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-060-relax-eabf8dd9.mp3",
   "pool": "relax"
  },
  "nomi-window-1": {
   "speaker": "nomi",
   "text": "[softly] NeoChinatown looks beautiful from here, doesn't it?",
   "file": "extra/tea-duo/nomi-window-1.mp3",
   "duration": 3.54,
   "hash": "4967c9247e99a57da0e77c80b75ef9ab4a21d5094ed0dbffc89405f16e69291e",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-071-window-878eb3cd.mp3",
   "pool": "window"
  },
  "nomi-window-2": {
   "speaker": "nomi",
   "text": "[playfully] So many people outside... and only one handsome visitor in here.",
   "file": "extra/tea-duo/nomi-window-2.mp3",
   "duration": 5.06,
   "hash": "17b637c402204db62a4c2377ab04f4c42aba2e3e53d507542b1bc7d575439c94",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-072-window-05fc13a6.mp3",
   "pool": "window"
  },
  "nomi-window-3": {
   "speaker": "nomi",
   "text": "[thoughtfully] Sometimes I wonder how many secrets these streets keep.",
   "file": "extra/tea-duo/nomi-window-3.mp3",
   "duration": 4.19,
   "hash": "ac00b13bb3d1d218ac11da34a201a13a52656b70ac1ba38cf9c380a8e5133113",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-073-window-e59aa963.mp3",
   "pool": "window"
  },
  "nomi-window-4": {
   "speaker": "nomi",
   "text": "[giggles] Don't stare outside too long. You'll miss the best view.",
   "file": "extra/tea-duo/nomi-window-4.mp3",
   "duration": 4.98,
   "hash": "bbf8dd521b7f67a031fd673625cbae03296bb518ec039ebc9fa69f8354a88edc",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-074-window-f645bd36.mp3",
   "pool": "window"
  },
  "nomi-window-5": {
   "speaker": "nomi",
   "text": "[warmly] I prefer the company in here, personally.",
   "file": "extra/tea-duo/nomi-window-5.mp3",
   "duration": 2.91,
   "hash": "4512ea859361d86e69baf0370a4c58e14665f8496fb03a983c8c7ab4f3ab2558",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-075-window-e0a792c1.mp3",
   "pool": "window"
  },
  "nomi-aside-1": {
   "speaker": "nomi",
   "text": "[whispers] Between you and me... our tea isn't really about the tea.",
   "file": "extra/tea-duo/nomi-aside-1.mp3",
   "duration": 4.35,
   "hash": "0541210fe4e9de64e82f5537b72cd4902bc978a7934a8d167ae133ff6d3a8856",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
   "source": "line-111-aside-a359aac9.mp3",
   "pool": "aside"
  },
  "nomi-aside-2": {
   "speaker": "nomi",
   "text": "[giggles] Don't tell anyone, but I think you're rather cute.",
   "file": "extra/tea-duo/nomi-aside-2.mp3",
   "duration": 4.35,
   "hash": "e574cdf1ad2d4728a9c2e3e2984d122d45b44941397a4fec18d608b4710862df",
   "type": "audio/mpeg",
   "package": "local-mwspnx2p",
