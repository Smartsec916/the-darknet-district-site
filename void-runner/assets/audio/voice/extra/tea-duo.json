   "file": "extra/tea-duo/se7en-relax-4.mp3",
   "duration": 4.66,
   "hash": "2c9af02ae1701a1e162d1d13974b81dd15cc3f83d27f94fdc882f728636cd995",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-059-relax-7d7b027f.mp3",
   "pool": "relax"
  },
  "se7en-relax-5": {
   "speaker": "se7en",
   "text": "[warmly] This is nice. Just the three of us enjoying a quiet moment.",
   "file": "extra/tea-duo/se7en-relax-5.mp3",
   "duration": 4.74,
   "hash": "4d1bae18297772961487bae5e9846f33c69fda76a3f852456ea84a58e18d4958",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-060-relax-f8339736.mp3",
   "pool": "relax"
  },
  "se7en-window-1": {
   "speaker": "se7en",
   "text": "[thoughtfully] NeoChinatown looks beautiful tonight. So many little lights.",
   "file": "extra/tea-duo/se7en-window-1.mp3",
   "duration": 4.82,
   "hash": "b2215748504409e8a9058a87c9ede2eec9c275a6beed7b8d0676dcf700595bdd",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-071-window-4dcf9021.mp3",
   "pool": "window"
  },
  "se7en-window-2": {
   "speaker": "se7en",
   "text": "[playfully] I can identify every building out there. But I'd rather look at you.",
   "file": "extra/tea-duo/se7en-window-2.mp3",
   "duration": 5.13,
   "hash": "e9d2d6dd5a1d2dc5142074e1d36eb1f56fe048c2501a27584d8b3c3e43ab55c5",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-072-window-af86fe35.mp3",
   "pool": "window"
  },
  "se7en-window-3": {
   "speaker": "se7en",
   "text": "[curious] Humans invented cities this beautiful. You're quite remarkable.",
   "file": "extra/tea-duo/se7en-window-3.mp3",
   "duration": 4.98,
   "hash": "a7d3660bee5eb7799e3d3ab0eb93cbc8a2638339ccca94e5c9e525d16438a4ca",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-073-window-a6b7af13.mp3",
   "pool": "window"
  },
  "se7en-window-4": {
   "speaker": "se7en",
   "text": "[giggles] Nomi says I spend too much time analyzing the view.",
   "file": "extra/tea-duo/se7en-window-4.mp3",
   "duration": 4.98,
   "hash": "7f2375e13613798ed540a8dffd256079246c363888f39fefd179a744b7602a77",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-074-window-7eea7c84.mp3",
   "pool": "window"
  },
  "se7en-window-5": {
   "speaker": "se7en",
   "text": "[softly] Sometimes I wonder what the world looks like through human eyes.",
   "file": "extra/tea-duo/se7en-window-5.mp3",
   "duration": 4.43,
   "hash": "b68036f1e8fc93fc5fa3a45c0dc771a8f13f98c2fd85a891026c5df0becac302",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-075-window-5f6a847e.mp3",
   "pool": "window"
  },
  "se7en-aside-1": {
   "speaker": "se7en",
   "text": "[whispers] Between us, I think Nomi has a little crush on you.",
   "file": "extra/tea-duo/se7en-aside-1.mp3",
   "duration": 3.85,
   "hash": "d96eebf49db39f2a7308e453ace0c19d957d1c72cf88f62c33cf80058a9fc182",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-111-aside-43ebe3f4.mp3",
   "pool": "aside"
  },
  "se7en-aside-2": {
   "speaker": "se7en",
   "text": "[giggles] Don't tell Nomi, but I think my tea jokes are better.",
   "file": "extra/tea-duo/se7en-aside-2.mp3",
   "duration": 5.13,
   "hash": "a5f6dce070139b635e9da343a2a8e5894d948e03be83784f856fdf75f46f96ec",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-112-aside-9828f8a9.mp3",
   "pool": "aside"
  },
  "se7en-aside-3": {
   "speaker": "se7en",
   "text": "[playfully] My sensors say you're smiling. I like that.",
   "file": "extra/tea-duo/se7en-aside-3.mp3",
   "duration": 3.85,
   "hash": "de0b7135bd51c80c3efe30cf6faadc4d7e7fe01abad6dc6f45a3dcf8fbbaecf9",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-113-aside-bb33f34c.mp3",
   "pool": "aside"
  },
  "se7en-aside-4": {
   "speaker": "se7en",
   "text": "[whispers] I wasn't originally designed to be this mischievous.",
   "file": "extra/tea-duo/se7en-aside-4.mp3",
   "duration": 3.7,
   "hash": "f61dc9fac81bc9f3090fc37f7a3ae1547a18c7e83866a4e9ed5440e22da014bf",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-114-aside-9e748139.mp3",
   "pool": "aside"
  },
  "se7en-aside-5": {
   "speaker": "se7en",
   "text": "[teasing] Nomi calls me a bad influence. I consider that a compliment.",
   "file": "extra/tea-duo/se7en-aside-5.mp3",
   "duration": 4.51,
   "hash": "7aa7aa22bd47ecfadf75e41063bc4ebaef91519c4329923a60ff01711706994c",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-115-aside-6b3562b3.mp3",
   "pool": "aside"
  },
  "se7en-bye-1": {
   "speaker": "se7en",
   "text": "[sweetly] Goodbye, handsome. I hope you'll visit us again.",
   "file": "extra/tea-duo/se7en-bye-1.mp3",
   "duration": 3.62,
   "hash": "613cf34224cf2e23c1b40c8831dfb6b66cb086ea6667158c6599a78a7436c144",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-061-bye-f23e94fa.mp3",
   "pool": "bye"
  },
  "se7en-bye-2": {
   "speaker": "se7en",
   "text": "[playfully] Don't forget us. My memory is considerably better than yours.",
   "file": "extra/tea-duo/se7en-bye-2.mp3",
   "duration": 4.59,
   "hash": "87f7b40c29e6a63b7288e19c9d5b91bc36d909e92e4b9c523aeb9f50abf6e63e",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-062-bye-8f916655.mp3",
   "pool": "bye"
  },
  "se7en-bye-3": {
   "speaker": "se7en",
   "text": "[giggles] I'll keep the tea warm. Metaphorically speaking.",
   "file": "extra/tea-duo/se7en-bye-3.mp3",
   "duration": 4.66,
   "hash": "50408dd87040315303d6bfd66d6c07422373ec0df3d07b94bde4838c3b1f5b0d",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-063-bye-893e8fea.mp3",
   "pool": "bye"
  },
  "se7en-bye-4": {
   "speaker": "se7en",
   "text": "[softly] It was lovely meeting you.",
   "file": "extra/tea-duo/se7en-bye-4.mp3",
   "duration": 2.03,
   "hash": "c1bf8ec3a5ad22e643c9df7e8a08f4c5c2f9641ececec09624f518430acaf03e",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-064-bye-71ab798b.mp3",
   "pool": "bye"
  },
  "se7en-bye-5": {
   "speaker": "se7en",
   "text": "[flirty] Come back soon. I may have developed some new hospitality protocols.",
   "file": "extra/tea-duo/se7en-bye-5.mp3",
   "duration": 5.06,
   "hash": "8cbd192e8909a1d24b603e736cbf381e186dfe378cadbbef5864922927e1ea25",
   "type": "audio/mpeg",
   "package": "local-mwsqafm4",
   "source": "line-065-bye-bbeadff2.mp3",
   "pool": "bye"
  }
 }
