// Merge these matches into the Firebase project's existing Firestore rules.
// Do not replace rules for the homepage, VOID//RUNNER, or other services.
// Blackout Protocol clients access public data through the Flask API; only
// Firebase Admin on the trusted server may write or read these collections.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bp_profiles/{document=**} { allow read, write: if false; }
    match /bp_handles/{document=**} { allow read, write: if false; }
    match /bp_stats/{document=**} { allow read, write: if false; }
    match /bp_leaderboard/{document=**} { allow read, write: if false; }
    match /bp_runs/{document=**} { allow read, write: if false; }
    match /bp_submissions/{document=**} { allow read, write: if false; }
  }
}
